{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "skipLibCheck": true, "types": ["node"], "allowImportingTsExtensions": true
  },
  "include": ["core", "electron", "renderer"]
}
